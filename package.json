    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "~1.104.0",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.1.14",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "~7.0.2",
